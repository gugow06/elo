# Copie para .env:  cp .env.example .env
# Banco (o docker compose usa estes mesmos valores)
POSTGRES_USER=elo
POSTGRES_PASSWORD=elo_dev_local
POSTGRES_DB=elo
DATABASE_URL=postgresql://elo:elo_dev_local@localhost:5432/elo

# API
PORT=3333
JWT_SECRET=troque-este-segredo-em-qualquer-ambiente-real

# E-mail do código de acesso (Resend). Vazio = o código só aparece no log da API.
# Sem domínio verificado, use o remetente de teste: o Resend só entrega no e-mail dono da conta.
RESEND_API_KEY=
RESEND_FROM="ELO <onboarding@resend.dev>"

# Login com Google: Client IDs aceitos como audiência do ID token, separados por vírgula.
# Use o "Web client ID" do Google Cloud (o mesmo passado ao app em GOOGLE_SERVER_CLIENT_ID).
GOOGLE_CLIENT_IDS=

# Triagem: deixe vazio para usar só as regras + classificador offline.
# Qualquer endpoint compatível com /v1/chat/completions. Ex. (Gemini):
#   LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   LLM_MODELO=gemini-2.5-flash
LLM_URL=
LLM_API_KEY=
LLM_MODELO=
LLM_LIMIAR_CONFIANCA=0.75
# Opcional: "none" desliga o raciocínio estendido (mais rápido) em modelos que suportam
LLM_ESFORCO_RACIOCINIO=
LLM_TIMEOUT_MS=20000

# Painel web: URL da API vista pelo navegador
NEXT_PUBLIC_API_URL=http://localhost:3333

# Modo demonstração. Local: true. Produção: false nos dois.
#   MODO_DEMO: contas de teste na tela de entrar, código de acesso na resposta da API, avisos de demonstração
#   SEED_DEMO: carrega os dados fictícios de desenvolvimento quando o banco está vazio
MODO_DEMO=true
SEED_DEMO=true

# Busca de endereço (compatível com Photon). Vazio = serviço público gratuito photon.komoot.io
GEOCODER_URL=
# Busca de endereço do painel (Locais da rede). Sem chave: CEP + Nominatim + Photon (gratuitos, param na rua).
# Com chave, acerta o número da casa:
# - TomTom (recomendado, sem cartão): developer.tomtom.com → criar conta → My Dashboard → Keys
TOMTOM_API_KEY=
# - Google Geocoding (pede faturamento no Google Cloud)
GOOGLE_MAPS_API_KEY=
# Nominatim próprio (opcional); vazio = nominatim.openstreetmap.org (máx. 1 consulta/s)
NOMINATIM_URL=

# Endereço do painel, usado no e-mail de convite da equipe
PAINEL_URL=http://localhost:3000

# Wokwi CLI: token da sua conta (wokwi.com/dashboard/ci), para o teste automático do Ponto de Coleta
WOKWI_CLI_TOKEN=
