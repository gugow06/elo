# Copie para .env:  cp .env.example .env
# Banco (o docker compose usa estes mesmos valores)
POSTGRES_USER=elo
POSTGRES_PASSWORD=elo_dev_local
POSTGRES_DB=elo
DATABASE_URL=postgresql://elo:elo_dev_local@localhost:5432/elo

# API
PORT=3333
JWT_SECRET=troque-este-segredo-em-qualquer-ambiente-real

# Triagem: deixe vazio para usar só as regras + classificador offline.
# Qualquer endpoint compatível com /v1/chat/completions. Ex. (Gemini):
#   LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   LLM_MODELO=gemini-2.5-flash
LLM_URL=
LLM_API_KEY=
LLM_MODELO=
LLM_LIMIAR_CONFIANCA=0.75
# Opcional: "none" desliga o raciocínio estendido (mais rápido) em modelos que suportam
LLM_ESFORCO_RACIOCINIO=
LLM_TIMEOUT_MS=20000

# Painel web: URL da API vista pelo navegador
NEXT_PUBLIC_API_URL=http://localhost:3333
